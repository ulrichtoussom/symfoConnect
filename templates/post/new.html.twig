{% extends 'base.html.twig' %}
{% block title %}Nouveau post — SymfoConnect{% endblock %}
{% block body %}

<div class="max-w-xl mx-auto">
    <div class="flex items-center gap-3 mb-6">
        <a href="{{ path('app_home') }}" class="p-2 text-slate-500 hover:text-white hover:bg-slate-800 rounded-lg transition-colors">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/></svg>
        </a>
        <h1 class="text-xl font-bold text-white">Créer un post</h1>
    </div>

    <div class="bg-slate-900 border border-slate-800 rounded-2xl p-6">
        <div class="flex gap-3">
            <div class="w-10 h-10 rounded-full avatar-{{ app.user.username|slice(0,1)|lower }} flex items-center justify-center text-white font-bold text-sm flex-shrink-0">
                {{ app.user.username|slice(0,1)|upper }}
            </div>
            <form method="POST" class="flex-1">
                <textarea name="content" id="post-content" rows="5" maxlength="500"
                    placeholder="Quoi de neuf ? Partage quelque chose..."
                    class="w-full bg-transparent text-white placeholder-slate-600 text-[15px] leading-relaxed resize-none outline-none border-b border-slate-800 pb-4 focus:border-indigo-800 transition-colors"
                    oninput="updateCounter(this)"></textarea>
                <div class="flex items-center justify-between mt-4">
                    <div class="flex items-center gap-2">
                        <svg class="w-8 h-8 -rotate-90" viewBox="0 0 36 36">
                            <circle cx="18" cy="18" r="15" fill="none" stroke="#1e293b" stroke-width="3"/>
                            <circle id="char-circle" cx="18" cy="18" r="15" fill="none" stroke="#6366f1" stroke-width="3" stroke-dasharray="94.2" stroke-dashoffset="94.2" style="transition:stroke-dashoffset .2s,stroke .2s"/>
                        </svg>
                        <span id="char-count" class="text-slate-600 text-xs">0 / 500</span>
                    </div>
                    <div class="flex items-center gap-2">
                        <a href="{{ path('app_home') }}" class="px-4 py-2 text-sm font-medium text-slate-400 hover:text-white border border-slate-700 hover:border-slate-500 rounded-full transition-colors">Annuler</a>
                        <button type="submit" id="post-btn" disabled class="px-6 py-2 bg-indigo-600 hover:bg-indigo-500 disabled:bg-indigo-900 disabled:text-indigo-600 disabled:cursor-not-allowed text-white text-sm font-semibold rounded-full transition-colors">Publier</button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
function updateCounter(t){
    const l=t.value.length,p=l/500;
    document.getElementById('char-count').textContent=l+' / 500';
    const c=document.getElementById('char-circle');
    c.style.strokeDashoffset=94.2-(p*94.2);
    c.style.stroke=p>=.9?'#f43f5e':p>=.7?'#f97316':'#6366f1';
    document.getElementById('post-btn').disabled=l<5;
}
</script>

{% endblock %}
