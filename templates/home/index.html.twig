{% extends 'base.html.twig' %}

{% block title %}Accueil{% endblock %}

{% block body %}

<h1>Derniers posts</h1>

{% for post in posts %}
    <div class="post">
        <p>{{ post.content }}</p>

        <small>
            Par 
            <a href="{{ path('app_profile', {username: post.author.username}) }}">
                {{ post.author.username }}
            </a>
            le {{ post.createdAt|date('d/m/Y H:i') }}
        </small>
    </div>
{% else %}
    <p>Aucun post pour le moment.</p>
{% endfor %}

{% endblock %}