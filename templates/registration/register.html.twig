{% extends 'base.html.twig' %}
{% block title %}Créer un compte — SymfoConnect{% endblock %}
{% block body %}
<div class="min-h-[80vh] flex items-center justify-center">
    <div class="w-full max-w-sm">
        <div class="text-center mb-8">
            <span class="text-4xl">⚡</span>
            <h1 class="text-2xl font-bold text-white mt-2">Rejoindre SymfoConnect</h1>
            <p class="text-slate-500 text-sm mt-1">Crée ton compte en quelques secondes</p>
        </div>
        <div class="bg-slate-900 border border-slate-800 rounded-2xl p-7">
            {{ form_errors(registrationForm) }}
            {{ form_start(registrationForm, {'attr': {'class': 'space-y-4', 'novalidate': 'novalidate'}}) }}
                <div>
                    {{ form_label(registrationForm.email, 'Adresse email', {'label_attr': {'class': 'block text-xs font-semibold text-slate-400 uppercase tracking-wider mb-1.5'}}) }}
                    {{ form_widget(registrationForm.email, {'attr': {'class': 'w-full bg-slate-800/60 border border-slate-700 hover:border-slate-600 focus:border-indigo-500 text-white placeholder-slate-600 rounded-xl px-4 py-2.5 text-sm outline-none transition-colors', 'placeholder': 'alice@example.com'}}) }}
                    {{ form_errors(registrationForm.email) }}
                </div>
                <div>
                    {{ form_label(registrationForm.plainPassword, 'Mot de passe', {'label_attr': {'class': 'block text-xs font-semibold text-slate-400 uppercase tracking-wider mb-1.5'}}) }}
                    {{ form_widget(registrationForm.plainPassword, {'attr': {'class': 'w-full bg-slate-800/60 border border-slate-700 hover:border-slate-600 focus:border-indigo-500 text-white placeholder-slate-600 rounded-xl px-4 py-2.5 text-sm outline-none transition-colors', 'placeholder': '6 caractères minimum'}}) }}
                    {{ form_errors(registrationForm.plainPassword) }}
                </div>
                <div class="flex items-start gap-3 pt-1">
                    {{ form_widget(registrationForm.agreeTerms, {'attr': {'class': 'mt-0.5 w-4 h-4 accent-indigo-500 flex-shrink-0'}}) }}
                    {{ form_label(registrationForm.agreeTerms, "J'accepte les conditions d'utilisation", {'label_attr': {'class': 'text-slate-400 text-sm leading-snug cursor-pointer'}}) }}
                    {{ form_errors(registrationForm.agreeTerms) }}
                </div>
                <button type="submit" class="w-full bg-indigo-600 hover:bg-indigo-500 text-white font-semibold py-2.5 px-4 rounded-xl text-sm transition-colors mt-2">Créer mon compte</button>
            {{ form_end(registrationForm) }}
        </div>
        <p class="text-center text-slate-600 text-sm mt-5">
            Déjà membre ? <a href="{{ path('app_login') }}" class="text-indigo-400 hover:text-indigo-300 font-medium transition-colors">Se connecter</a>
        </p>
    </div>
</div>
{% endblock %}
