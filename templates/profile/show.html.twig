{% extends 'base.html.twig' %}
{% block title %}@{{ user.username }} — SymfoConnect{% endblock %}
{% block body %}

<div class="rounded-2xl overflow-hidden border border-slate-800 mb-6">
    <div class="h-32 bg-gradient-to-br from-indigo-900 via-violet-900 to-slate-900"></div>
    <div class="bg-slate-900 px-6 pb-6">
        <div class="flex items-end justify-between -mt-10 mb-4">
            <div class="w-20 h-20 rounded-2xl avatar-{{ user.username|slice(0,1)|lower }} flex items-center justify-center text-white font-bold text-3xl ring-4 ring-slate-900">
                {{ user.username|slice(0,1)|upper }}
            </div>
            {% if app.user and app.user != user %}
                <div class="flex items-center gap-2">
                    <a href="{{ path('app_messages_show', {username: user.username}) }}"
                       class="flex items-center gap-2 px-4 py-2 border border-slate-700 hover:border-indigo-500 text-slate-400 hover:text-indigo-400 text-sm font-semibold rounded-full transition-colors">
                        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z"/></svg>
                        Message
                    </a>
                    {% if app.user.following.contains(user) %}
                        <a href="{{ path('app_unfollow', {id: user.id}) }}" class="flex items-center gap-2 px-5 py-2 border border-slate-600 hover:border-red-500 text-slate-300 hover:text-red-400 text-sm font-semibold rounded-full transition-all group">
                            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13 7a4 4 0 11-8 0 4 4 0 018 0zM9 14a6 6 0 00-6 6v1h12v-1a6 6 0 00-6-6zM21 12h-6"/></svg>
                            <span class="group-hover:hidden">Suivi</span><span class="hidden group-hover:inline">Se désabonner</span>
                        </a>
                    {% else %}
                        <a href="{{ path('app_follow', {id: user.id}) }}" class="flex items-center gap-2 px-5 py-2 bg-indigo-600 hover:bg-indigo-500 text-white text-sm font-semibold rounded-full transition-colors">
                            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z"/></svg>
                            Suivre
                        </a>
                    {% endif %}
                </div>
            {% elseif not app.user %}
                <a href="{{ path('app_login') }}" class="px-5 py-2 border border-slate-700 hover:border-indigo-500 text-slate-400 hover:text-indigo-400 text-sm font-semibold rounded-full transition-colors">Suivre</a>
            {% endif %}
        </div>

        <h1 class="text-xl font-bold text-white">{{ user.username }}</h1>
        <p class="text-slate-500 text-sm">@{{ user.username }}</p>
        {% if user.bio %}<p class="text-slate-300 text-sm mt-3 leading-relaxed">{{ user.bio }}</p>{% endif %}

        <div class="flex items-center gap-6 mt-4 pt-4 border-t border-slate-800">
            <div class="text-center"><span class="block text-lg font-bold text-white">{{ user.posts|length }}</span><span class="text-slate-500 text-xs">Posts</span></div>
            <div class="w-px h-8 bg-slate-800"></div>
            <div class="text-center"><span class="block text-lg font-bold text-white">{{ user.followers|length }}</span><span class="text-slate-500 text-xs">Abonnés</span></div>
            <div class="w-px h-8 bg-slate-800"></div>
            <div class="text-center"><span class="block text-lg font-bold text-white">{{ user.following|length }}</span><span class="text-slate-500 text-xs">Abonnements</span></div>
            {% if user.createdAt %}
                <div class="ml-auto text-slate-600 text-xs">Membre depuis {{ user.createdAt|date('M Y') }}</div>
            {% endif %}
        </div>
    </div>
</div>

<div class="flex items-center gap-2 mb-4">
    <h2 class="text-base font-semibold text-white">Publications</h2>
    <span class="px-2 py-0.5 bg-slate-800 text-slate-400 text-xs rounded-full">{{ user.posts|length }}</span>
</div>

{% if user.posts is empty %}
    <div class="text-center py-16 text-slate-600">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-10 h-10 mx-auto mb-3 opacity-40" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/></svg>
        <p class="text-sm">Aucune publication pour le moment.</p>
    </div>
{% else %}
    <div class="flex flex-col gap-3">
        {% for post in user.posts %}{{ include('partials/_post_card.html.twig') }}{% endfor %}
    </div>
{% endif %}

{% endblock %}
