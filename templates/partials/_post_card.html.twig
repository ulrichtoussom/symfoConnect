<article class="bg-slate-900 border border-slate-800 rounded-2xl p-5 hover:border-slate-700 transition-all group">
    <div class="flex gap-3">
        <a href="{{ path('app_profile', {username: post.author.username}) }}" class="flex-shrink-0">
            <div class="w-10 h-10 rounded-full avatar-{{ post.author.username|slice(0,1)|lower }} flex items-center justify-center text-white font-bold text-sm ring-2 ring-slate-800 group-hover:ring-slate-700 transition-all">
                {{ post.author.username|slice(0,1)|upper }}
            </div>
        </a>
        <div class="flex-1 min-w-0">
            <div class="flex items-center gap-2 flex-wrap">
                <a href="{{ path('app_profile', {username: post.author.username}) }}" class="font-semibold text-white hover:text-indigo-400 transition-colors text-sm">{{ post.author.username }}</a>
                <span class="text-slate-600 text-xs">·</span>
                <time class="text-slate-500 text-xs">{{ post.createdAt|date('d M à H:i') }}</time>
            </div>
            <p class="text-slate-300 mt-2 leading-relaxed text-[15px] break-words">{{ post.content }}</p>
            <div class="flex items-center gap-5 mt-3 pt-3 border-t border-slate-800/80">
                {% if app.user %}
                    {% if post.likedBy.contains(app.user) %}
                        <a href="{{ path('app_unlike', {id: post.id}) }}" class="flex items-center gap-1.5 text-rose-400 hover:text-rose-300 transition-colors text-sm font-medium">
                            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M12 21.593c-5.63-5.539-11-10.297-11-14.402C1 3.534 3.534 1 6.801 1 8.624 1 10.09 1.897 12 4c1.91-2.103 3.376-3 5.199-3C20.466 1 23 3.534 23 7.191c0 4.105-5.37 8.863-11 14.402z"/></svg>
                            {{ post.likedBy|length }}
                        </a>
                    {% else %}
                        <a href="{{ path('app_like', {id: post.id}) }}" class="flex items-center gap-1.5 text-slate-500 hover:text-rose-400 transition-colors text-sm">
                            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"/></svg>
                            {{ post.likedBy|length }}
                        </a>
                    {% endif %}
                {% else %}
                    <span class="flex items-center gap-1.5 text-slate-600 text-sm">
                        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"/></svg>
                        {{ post.likedBy|length }}
                    </span>
                {% endif %}
            </div>
        </div>
    </div>
</article>
