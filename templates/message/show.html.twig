{% extends 'base.html.twig' %}
{% block title %}Conversation avec {{ partner.username }} — SymfoConnect{% endblock %}
{% block body %}

{# En-tête #}
<div class="flex items-center gap-3 mb-6">
    <a href="{{ path('app_messages_index') }}" class="p-2 text-slate-500 hover:text-white hover:bg-slate-800 rounded-lg transition-colors">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/></svg>
    </a>
    <a href="{{ path('app_profile', {username: partner.username}) }}" class="flex items-center gap-3 hover:opacity-80 transition-opacity">
        <div class="w-10 h-10 rounded-full avatar-{{ partner.username|slice(0,1)|lower }} flex items-center justify-center text-white font-bold text-sm">
            {{ partner.username|slice(0,1)|upper }}
        </div>
        <div>
            <p class="font-semibold text-white text-sm leading-none">{{ partner.username }}</p>
            <p class="text-slate-500 text-xs mt-0.5">Voir le profil</p>
        </div>
    </a>
</div>

{# Historique #}
<div class="flex flex-col gap-2 mb-6 max-h-[60vh] overflow-y-auto px-1" id="messages-container">
    {% if messages is empty %}
        <p class="text-center text-slate-600 text-sm py-10">Commence la conversation !</p>
    {% else %}
        {% set prevDate = null %}
        {% for message in messages %}
            {% set isMe = message.sender == app.user %}
            {% set msgDate = message.createdAt|date('d/m/Y') %}

            {# Séparateur de date #}
            {% if msgDate != prevDate %}
                <div class="flex items-center gap-3 my-3">
                    <div class="flex-1 h-px bg-slate-800"></div>
                    <span class="text-slate-600 text-xs px-2">{{ msgDate == "now"|date('d/m/Y') ? "Aujourd'hui" : msgDate }}</span>
                    <div class="flex-1 h-px bg-slate-800"></div>
                </div>
                {% set prevDate = msgDate %}
            {% endif %}

            <div class="flex {{ isMe ? 'justify-end' : 'justify-start' }} items-end gap-2">

                {# Avatar partenaire à gauche #}
                {% if not isMe %}
                    <div class="w-7 h-7 rounded-full avatar-{{ message.sender.username|slice(0,1)|lower }} flex items-center justify-center text-white font-bold text-xs flex-shrink-0">
                        {{ message.sender.username|slice(0,1)|upper }}
                    </div>
                {% endif %}

                <div class="max-w-[68%] flex flex-col {{ isMe ? 'items-end' : 'items-start' }}">
                    <div class="px-4 py-2.5 rounded-2xl text-sm leading-relaxed break-words
                        {% if isMe %}
                            bg-indigo-600 text-white rounded-br-none
                        {% else %}
                            bg-slate-700 text-slate-100 rounded-bl-none
                        {% endif %}">
                        {{ message.content }}
                    </div>
                    <time class="text-slate-600 text-[11px] mt-1 px-1">
                        {{ message.createdAt|date('H:i') }}
                    </time>
                </div>

                {# Petit triangle indicateur côté moi #}
                {% if isMe %}
                    <div class="w-7 h-7 flex-shrink-0"></div>
                {% endif %}

            </div>
        {% endfor %}
    {% endif %}
</div>

{# Formulaire d'envoi #}
<div class="bg-slate-900 border border-slate-800 rounded-2xl p-3">
    <form method="POST" class="flex items-end gap-3">
        <textarea name="content" rows="2" placeholder="Écris un message..."
            class="flex-1 bg-transparent text-white placeholder-slate-600 text-sm leading-relaxed resize-none outline-none py-1"
            onkeydown="if(event.key==='Enter'&&!event.shiftKey){event.preventDefault();this.form.submit();}"
        ></textarea>
        <button type="submit"
            class="flex-shrink-0 p-2.5 bg-indigo-600 hover:bg-indigo-500 text-white rounded-xl transition-colors">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"/></svg>
        </button>
    </form>
</div>

<script>
    const c = document.getElementById('messages-container');
    if (c) c.scrollTop = c.scrollHeight;
</script>

{% endblock %}
