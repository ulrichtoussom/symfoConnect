{% extends 'base.html.twig' %}
{% block title %}Messages — SymfoConnect{% endblock %}
{% block body %}

<div class="flex items-center justify-between mb-6">
    <div>
        <h1 class="text-2xl font-bold text-white">Messages</h1>
        <p class="text-slate-500 text-sm mt-0.5">{{ conversations|length }} conversation{{ conversations|length > 1 ? 's' : '' }}</p>
    </div>
</div>

{% if conversations is empty %}
    <div class="text-center py-20">
        <div class="w-20 h-20 mx-auto mb-5 rounded-full bg-slate-900 border border-slate-800 flex items-center justify-center">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-9 h-9 text-slate-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z"/>
            </svg>
        </div>
        <h2 class="text-lg font-semibold text-slate-400">Aucun message</h2>
        <p class="text-slate-600 text-sm mt-1">Visite un profil et envoie un message !</p>
    </div>
{% else %}
    <div class="flex flex-col gap-2">
        {% for conv in conversations %}
            <a href="{{ path('app_messages_show', {username: conv.partner.username}) }}"
               class="flex items-center gap-4 px-5 py-4 bg-slate-900 border {{ conv.unreadCount > 0 ? 'border-indigo-800/60 bg-indigo-950/30' : 'border-slate-800 hover:border-slate-700' }} rounded-2xl transition-all">

                {# Avatar #}
                <div class="w-12 h-12 rounded-full avatar-{{ conv.partner.username|slice(0,1)|lower }} flex items-center justify-center text-white font-bold text-lg flex-shrink-0">
                    {{ conv.partner.username|slice(0,1)|upper }}
                </div>

                {# Infos #}
                <div class="flex-1 min-w-0">
                    <div class="flex items-center justify-between">
                        <span class="font-semibold text-white text-sm">{{ conv.partner.username }}</span>
                        <time class="text-slate-600 text-xs">{{ conv.lastMessage.createdAt|date('d/m H:i') }}</time>
                    </div>
                    <p class="text-slate-400 text-sm truncate mt-0.5">
                        {% if conv.lastMessage.sender == app.user %}<span class="text-slate-600">Toi : </span>{% endif %}
                        {{ conv.lastMessage.content|slice(0, 60) }}{% if conv.lastMessage.content|length > 60 %}…{% endif %}
                    </p>
                </div>

                {# Badge non lus #}
                {% if conv.unreadCount > 0 %}
                    <span class="w-6 h-6 bg-indigo-500 text-white text-xs font-bold rounded-full flex items-center justify-center flex-shrink-0">
                        {{ conv.unreadCount }}
                    </span>
                {% endif %}
            </a>
        {% endfor %}
    </div>
{% endif %}

{% endblock %}
