{% extends 'base.html.twig' %}
{% block title %}Notifications — SymfoConnect{% endblock %}
{% block body %}

<div class="flex items-center justify-between mb-6">
    <div>
        <h1 class="text-2xl font-bold text-white">Notifications</h1>
        <p class="text-slate-500 text-sm mt-0.5">{{ notifications|length }} notification{{ notifications|length > 1 ? 's' : '' }}</p>
    </div>
</div>

{% if notifications is empty %}
    <div class="text-center py-20">
        <div class="w-20 h-20 mx-auto mb-5 rounded-full bg-slate-900 border border-slate-800 flex items-center justify-center">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-9 h-9 text-slate-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6 6 0 00-9.33-4.99M9 17H4l1.405-1.405A2.032 2.032 0 016 14.158V11a6 6 0 0112 0v3.159c0 .538.214 1.055.595 1.436L19 17h-4m-6 0v1a3 3 0 006 0v-1m-6 0h6"/></svg>
        </div>
        <h2 class="text-lg font-semibold text-slate-400">Tout est calme ici</h2>
    </div>
{% else %}
    <div class="flex flex-col gap-2">
        {% for notif in notifications %}
            <div class="flex items-start gap-4 px-5 py-4 rounded-2xl border transition-all {{ not notif.read ? 'bg-indigo-950/40 border-indigo-800/50' : 'bg-slate-900 border-slate-800 hover:border-slate-700' }}">
                <div class="flex-shrink-0 mt-0.5">
                    {% if notif.type == 'follow' %}
                        <div class="w-9 h-9 rounded-full bg-indigo-900/60 border border-indigo-700/50 flex items-center justify-center">
                            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-indigo-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z"/></svg>
                        </div>
                    {% elseif notif.type == 'message' %}
                        <div class="w-9 h-9 rounded-full bg-violet-900/50 border border-violet-700/50 flex items-center justify-center">
                            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-violet-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z"/></svg>
                        </div>
                    {% else %}
                        <div class="w-9 h-9 rounded-full bg-rose-900/40 border border-rose-800/50 flex items-center justify-center">
                            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-rose-400 fill-current" viewBox="0 0 24 24"><path d="M12 21.593c-5.63-5.539-11-10.297-11-14.402C1 3.534 3.534 1 6.801 1 8.624 1 10.09 1.897 12 4c1.91-2.103 3.376-3 5.199-3C20.466 1 23 3.534 23 7.191c0 4.105-5.37 8.863-11 14.402z"/></svg>
                        </div>
                    {% endif %}
                </div>
                <a href="{{ path('app_profile', {username: notif.sender.username}) }}" class="flex-shrink-0">
                    <div class="w-9 h-9 rounded-full avatar-{{ notif.sender.username|slice(0,1)|lower }} flex items-center justify-center text-white font-bold text-xs">
                        {{ notif.sender.username|slice(0,1)|upper }}
                    </div>
                </a>
                <div class="flex-1 min-w-0">
                    <p class="text-sm {{ not notif.read ? 'text-slate-200' : 'text-slate-400' }}">
                        <a href="{{ path('app_profile', {username: notif.sender.username}) }}" class="font-semibold text-white hover:text-indigo-400 transition-colors">{{ notif.sender.username }}</a>
                        {% if notif.type == 'follow' %}
                            a commencé à vous suivre.
                        {% elseif notif.type == 'message' %}
                            vous a envoyé un <a href="{{ path('app_messages_show', {username: notif.sender.username}) }}" class="text-violet-400 hover:underline">message privé</a>.
                        {% else %}
                            a aimé votre post.
                        {% endif %}
                    </p>
                    <time class="text-slate-600 text-xs">{{ notif.createdAt|date('d M Y à H:i') }}</time>
                </div>
                {% if not notif.read %}<div class="w-2 h-2 rounded-full bg-indigo-400 flex-shrink-0 mt-2"></div>{% endif %}
            </div>
        {% endfor %}
    </div>
{% endif %}

{% endblock %}
