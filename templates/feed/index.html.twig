{% extends 'base.html.twig' %}
{% block title %}Mon Feed — SymfoConnect{% endblock %}
{% block body %}

<div class="flex items-center justify-between mb-6">
    <div>
        <h1 class="text-2xl font-bold text-white">Mon Feed</h1>
        <p class="text-slate-500 text-sm mt-0.5">Publications des personnes que tu suis</p>
    </div>
    <a href="{{ path('app_post_new') }}" class="flex items-center gap-2 px-4 py-2 bg-indigo-600 hover:bg-indigo-500 text-white text-sm font-semibold rounded-full transition-colors">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"/></svg>
        Nouveau post
    </a>
</div>

{% if posts is empty %}
    <div class="text-center py-20">
        <div class="w-20 h-20 mx-auto mb-5 rounded-full bg-slate-900 border border-slate-800 flex items-center justify-center">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-9 h-9 text-slate-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
        </div>
        <h2 class="text-lg font-semibold text-slate-400">Ton feed est vide</h2>
        <p class="text-slate-600 text-sm mt-1 mb-5">Suis des utilisateurs pour voir leurs posts ici.</p>
        <a href="{{ path('app_home') }}" class="inline-flex items-center gap-2 px-5 py-2.5 bg-indigo-600 hover:bg-indigo-500 text-white text-sm font-semibold rounded-full transition-colors">Découvrir des membres</a>
    </div>
{% else %}
    <div class="flex flex-col gap-3">
        {% for post in posts %}
            {{ include('partials/_post_card.html.twig') }}
        {% endfor %}
    </div>
{% endif %}

{% endblock %}
