<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}SymfoConnect{% endblock %}</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
    <style>
        body { font-family: 'Inter', 'Segoe UI', Arial, sans-serif; }
        .avatar-a,.avatar-b,.avatar-c,.avatar-d,.avatar-e { background: linear-gradient(135deg,#3b82f6,#6366f1); }
        .avatar-f,.avatar-g,.avatar-h,.avatar-i,.avatar-j { background: linear-gradient(135deg,#8b5cf6,#a855f7); }
        .avatar-k,.avatar-l,.avatar-m,.avatar-n,.avatar-o { background: linear-gradient(135deg,#10b981,#14b8a6); }
        .avatar-p,.avatar-q,.avatar-r,.avatar-s,.avatar-t { background: linear-gradient(135deg,#f97316,#f59e0b); }
        .avatar-u,.avatar-v,.avatar-w,.avatar-x,.avatar-y,.avatar-z { background: linear-gradient(135deg,#ec4899,#f43f5e); }
        ::-webkit-scrollbar{width:6px} ::-webkit-scrollbar-track{background:#0f172a} ::-webkit-scrollbar-thumb{background:#334155;border-radius:3px}
        @keyframes slideIn{from{transform:translateX(100%);opacity:0}to{transform:translateX(0);opacity:1}}
        .toast{animation:slideIn .3s ease-out}
    </style>
</head>
<body class="bg-slate-950 text-white min-h-screen">

<nav class="fixed top-0 left-0 right-0 z-50 bg-slate-950/80 backdrop-blur-xl border-b border-slate-800">
    <div class="max-w-3xl mx-auto px-4 h-14 flex items-center justify-between gap-4">

        <a href="{{ path('app_home') }}" class="flex items-center gap-2 font-bold text-lg text-white hover:text-indigo-400 transition-colors flex-shrink-0">
            <span class="text-2xl">⚡</span><span>SymfoConnect</span>
        </a>

        <div class="flex items-center gap-1">
            {% if not app.user %}
                <a href="{{ path('app_login') }}" class="px-4 py-1.5 text-sm font-medium text-slate-300 hover:text-white rounded-lg hover:bg-slate-800 transition-colors">Connexion</a>
                <a href="{{ path('app_register') }}" class="px-4 py-1.5 text-sm font-semibold bg-indigo-600 hover:bg-indigo-500 text-white rounded-full transition-colors">S'inscrire</a>
            {% else %}
                <a href="{{ path('app_home') }}" class="px-3 py-1.5 text-sm text-slate-400 hover:text-white hover:bg-slate-800 rounded-lg transition-colors">Accueil</a>
                <a href="{{ path('app_feed') }}" class="px-3 py-1.5 text-sm text-slate-400 hover:text-white hover:bg-slate-800 rounded-lg transition-colors">Feed</a>
                <a href="{{ path('app_post_new') }}" class="px-3 py-1.5 text-sm font-semibold bg-indigo-600 hover:bg-indigo-500 text-white rounded-full transition-colors">+ Post</a>

                <a href="{{ path('app_notifications') }}" class="relative p-2 text-slate-400 hover:text-white hover:bg-slate-800 rounded-lg transition-colors">
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6 6 0 00-9.33-4.99M9 17H4l1.405-1.405A2.032 2.032 0 016 14.158V11a6 6 0 0112 0v3.159c0 .538.214 1.055.595 1.436L19 17h-4m-6 0v1a3 3 0 006 0v-1m-6 0h6"/></svg>
                    {% if unread_notifications_count > 0 %}
                        <span class="absolute top-1 right-1 w-4 h-4 bg-rose-500 text-white text-[10px] font-bold rounded-full flex items-center justify-center">{{ unread_notifications_count > 9 ? '9+' : unread_notifications_count }}</span>
                    {% endif %}
                </a>

                <a href="{{ path('app_profile', {'username': app.user.username}) }}" class="flex items-center gap-2 px-2 py-1 rounded-lg hover:bg-slate-800 transition-colors">
                    <div class="w-7 h-7 rounded-full avatar-{{ app.user.username|slice(0,1)|lower }} flex items-center justify-center text-white font-bold text-xs flex-shrink-0">{{ app.user.username|slice(0,1)|upper }}</div>
                    <span class="text-sm font-medium text-slate-300 hidden sm:block">{{ app.user.username }}</span>
                </a>

                <a href="{{ path('app_logout') }}" class="p-2 text-slate-500 hover:text-red-400 hover:bg-slate-800 rounded-lg transition-colors">
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/></svg>
                </a>
            {% endif %}
        </div>
    </div>
</nav>

<div class="fixed top-16 right-4 z-50 flex flex-col gap-2 pointer-events-none">
    {% for message in app.flashes('success') %}
        <div class="toast pointer-events-auto flex items-center gap-3 bg-emerald-900/90 border border-emerald-700 text-emerald-300 px-4 py-3 rounded-xl shadow-lg text-sm font-medium max-w-xs">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>{{ message }}
        </div>
    {% endfor %}
    {% for message in app.flashes('error') %}
        <div class="toast pointer-events-auto flex items-center gap-3 bg-red-900/90 border border-red-700 text-red-300 px-4 py-3 rounded-xl shadow-lg text-sm font-medium max-w-xs">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg>{{ message }}
        </div>
    {% endfor %}
</div>

<main class="max-w-3xl mx-auto px-4 pt-20 pb-10">
    {% block body %}{% endblock %}
</main>

</body>
</html>
