<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>{% block title %}SymfoConnect{% endblock %}</title>

    <style>
        body {
            font-family: Arial, sans-serif;
            margin: 0;
            background: #f5f6fa;
        }

        nav {
            background: #2f3640;
            padding: 15px;
        }

        nav a {
            color: white;
            margin-right: 15px;
            text-decoration: none;
            font-weight: bold;
        }

        .container {
            width: 800px;
            margin: 30px auto;
        }

        .post {
            background: white;
            padding: 15px;
            margin-bottom: 15px;
            border-radius: 8px;
        }

        .flash-success {
            background: #4cd137;
            padding: 10px;
            color: white;
            margin-bottom: 10px;
        }

        .flash-error {
            background: #e84118;
            padding: 10px;
            color: white;
            margin-bottom: 10px;
        }
    </style>
</head>

<body>

<nav>
    <a href="{{ path('app_home') }}">Accueil</a>
    <a href="{{ path('app_post_new') }}">Nouveau post</a>
    <a href="{{ path('app_profile', {'username': 'testuser'}) }}">Profil</a>
</nav>

<div class="container">
    {# 🔔 Flash messages #}
    {% for type, messages in app.flashes %}
        {% for message in messages %}
            <div class="flash-{{ type }}">
                {{ message }}
            </div>
        {% endfor %}
    {% endfor %}

    {% block body %}{% endblock %}
</div>

</body>
</html>