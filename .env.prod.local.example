# Copiez ce fichier en .env.prod.local et remplissez les valeurs réelles
# Ne committez JAMAIS .env.prod.local dans git

APP_ENV=prod
APP_SECRET=CHANGEME_une_chaine_aleatoire_de_32_caracteres

# Base de données MySQL en production
DATABASE_URL="mysql://db_user:db_password@127.0.0.1:3306/symfoconnect?serverVersion=8.0.32&charset=utf8mb4"

# Transport Messenger (Redis ou autre)
# MESSENGER_TRANSPORT_DSN=redis://localhost:6379/messages
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0

# Mailer SMTP en production
# MAILER_DSN=smtp://user:password@smtp.example.com:587
MAILER_DSN=smtp://user:password@smtp.example.com:587

# CORS — domaine(s) autorisés pour l'API
CORS_ALLOW_ORIGIN='^https?://mondomaine\.com$'

# JWT
JWT_SECRET_KEY=%kernel.project_dir%/config/jwt/private.pem
JWT_PUBLIC_KEY=%kernel.project_dir%/config/jwt/public.pem
JWT_PASSPHRASE=CHANGEME_passphrase_jwt
